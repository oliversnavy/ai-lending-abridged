# Default backend (RunConfig.backend="anthropic") -- required to run anything.
ANTHROPIC_API_KEY=

# Optional second backend (RunConfig.backend="baseten") -- open-weight model via
# Baseten's OpenAI-compatible Model APIs. Only needed if you want to run against that
# path instead of Anthropic.
BASETEN_API_KEY=

# Optional observability -- if set, LangChain's own callback system picks these up
# automatically (no code change needed) and traces every run to LangSmith.
LANGCHAIN_TRACING_V2=
LANGSMITH_API_KEY=
